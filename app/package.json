{
  "name": "minmin-matrix-studio",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN public/COPYRIGHT.md",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/textTools.test.mjs tests/gallery.test.mjs",
    "test:server": "npm run build:server && node --test tests/production.test.mjs",
    "dev": "vite --host 127.0.0.1 --port 4318 --strictPort",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview --host 127.0.0.1 --port 4318 --strictPort",
    "build:thumbnails": "python3 scripts/build-background-thumbnails.py"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "html-to-image": "1.11.13",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
